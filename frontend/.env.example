# Base das chamadas à topflop-api feitas pelo navegador.
# Em desenvolvimento deixe /api: o proxy do Vite repassa para VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Endereço real do backend (usado só pelo proxy do Vite).
VITE_API_PROXY_TARGET=http://localhost:3000

# Credencial do TMDB (https://www.themoviedb.org/settings/api).
# Aceita tanto a "API Key" curta quanto o "API Read Access Token" (começa com eyJ).
VITE_TMDB_API_KEY=
